{%- comment -%} Cart Drawer — AJAX cart slide-out panel {%- endcomment -%}

<div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>

<div class="cart-drawer" id="cart-drawer" aria-label="{{ 'general.cart' | t }}">
  <div class="cart-drawer-header">
    <h2 class="cart-drawer-title">{{ 'general.cart' | t }} (<span id="drawer-item-count">{{ cart.item_count }}</span>)</h2>
    <button class="cart-drawer-close" id="cart-drawer-close" aria-label="Close">
      {% render 'icon', name: 'x' %}
    </button>
  </div>

  <div class="cart-drawer-items" id="cart-drawer-items">
    {% if cart.item_count == 0 %}
      <div class="cart-drawer-empty">
        {% render 'icon', name: 'shopping-bag' %}
        <p>{{ 'general.your_cart_empty' | t }}</p>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item" data-line-item data-line="{{ forloop.index }}" data-variant-id="{{ item.variant_id }}">
          <img class="cart-item-image" src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" loading="lazy">
          <div class="cart-item-info">
            <div class="cart-item-title">{{ item.product.title }}</div>
            <div class="cart-item-variant">{{ item.variant.title }}</div>
            <div class="cart-item-price">{{ item.final_line_price | money }}</div>
            <div class="cart-item-actions">
              <div class="cart-item-qty">
                <button data-line-minus aria-label="Decrease">{% render 'icon', name: 'minus' %}</button>
                <span data-line-qty>{{ item.quantity }}</span>
                <button data-line-plus aria-label="Increase">{% render 'icon', name: 'plus' %}</button>
              </div>
              <button class="cart-item-remove" data-line-remove aria-label="Remove">
                {% render 'icon', name: 'trash' %}
              </button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-drawer-totals">
      <span class="cart-drawer-totals-label">{{ 'general.subtotal' | t }}</span>
      <span class="cart-drawer-totals-value" id="drawer-subtotal">{{ cart.total_price | money }}</span>
    </div>
    <a href="/checkout" class="cart-drawer-checkout-btn">
      {% render 'icon', name: 'shield-check' %}
      {{ 'general.proceed_checkout' | t }}
    </a>
    <a href="/" class="cart-drawer-continue">{{ 'general.return_to_store' | t }}</a>
  </div>
</div>
