{%- comment -%} Main Product Section — converted from ProductDetail.jsx
     Uses the current product object from Shopify's product template.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="pdp-container">
  {%- comment -%} Breadcrumbs {%- endcomment -%}
  <div class="pdp-header">
    <div class="pdp-breadcrumbs">
      <a href="/">{{ 'general.home' | t }}</a> /
      <a href="/collections/all">{{ 'general.buy' | t }}</a> /
      <span style="font-weight:700;">{{ product.title }}</span>
    </div>
    <div class="pdp-top-tags">
      <span class="pdp-tag">{{ 'product.new_badge' | t }}</span>
      <span class="pdp-tag-dot">&bull;</span>
      <span class="pdp-tag">{{ 'product.exclusive_launch' | t }}</span>
    </div>
  </div>

  <div class="pdp-grid">

    {%- comment -%} Gallery Column {%- endcomment -%}
    <div class="pdp-gallery-col">

      <div class="pdp-main-image-container">
        <div class="pdp-image-tags">
          <span class="pdp-image-tag glass">{{ 'product.sensor_tag' | t }}</span>
          <span class="pdp-image-tag dark">{{ 'product.finish_tag' | t }}</span>
        </div>
        <div class="pdp-image-tag-right">
          <span class="glass-subtle">{{ 'product.view_360' | t }}</span>
        </div>
        <img
          src="{{ product.featured_image | image_url: width: 1000 }}"
          alt="{{ product.featured_image.alt | default: product.title }}"
          class="pdp-main-image"
          id="pdp-main-img"
          width="1000"
          height="1250"
          loading="eager"
        >
        <div class="pdp-image-overlay">
          <div class="pdp-overlay-left">
            <span class="pdp-overlay-radar-icon">{% render 'icon', name: 'cpu' %}</span>
            <div>
              <div style="font-weight:700;color:#111827;">{{ 'product.radar_title' | t }}</div>
              <div style="color:#4b5563;font-size:11px;">{{ 'product.radar_desc' | t }}</div>
            </div>
          </div>
          <div class="pdp-overlay-active">{{ 'product.active' | t }}</div>
        </div>
      </div>

      {%- comment -%} Thumbnails {%- endcomment -%}
      <div class="pdp-thumbnails">
        {% for image in product.images limit: 4 %}
          <div class="pdp-thumb-card {% if forloop.first %}active{% endif %}" data-thumb data-image-src="{{ image | image_url: width: 1000 }}">
            <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
            <span class="pdp-thumb-text">
              {% if forloop.first %}{{ 'product.closed_front' | t }}{% else %}{{ image.alt | default: 'View' }}{% endif %}
            </span>
          </div>
        {% endfor %}
        {%- comment -%} Feature cards if less than 4 images {%- endcomment -%}
        {% assign remaining = 4 | minus: product.images.size %}
        {% if remaining > 0 %}
          <div class="pdp-thumb-card">
            <div class="pdp-thumb-icon">{% render 'icon', name: 'package' %}</div>
            <span class="pdp-thumb-text">35L + 35L</span>
            <span class="pdp-thumb-sub">{{ 'product.dual_lid' | t }}</span>
          </div>
        {% endif %}
        {% if remaining > 1 %}
          <div class="pdp-thumb-card">
            <div class="pdp-thumb-icon">{% render 'icon', name: 'droplets' %}</div>
            <span class="pdp-thumb-text">{{ 'product.washable_canvas' | t }}</span>
            <span class="pdp-thumb-sub">{{ 'product.bags_2x' | t }}</span>
          </div>
        {% endif %}
        {% if remaining > 2 %}
          <div class="pdp-thumb-card">
            <div class="pdp-thumb-icon">{% render 'icon', name: 'shield' %}</div>
            <span class="pdp-thumb-text">{{ 'product.led_guide' | t }}</span>
            <span class="pdp-thumb-sub">{{ 'product.night_light' | t }}</span>
          </div>
        {% endif %}
      </div>

      {%- comment -%} Specs Table {%- endcomment -%}
      <div class="pdp-specs-table">
        <div class="pdp-specs-header">
          <span class="pdp-specs-title">{{ 'product.specs_title' | t }}</span>
          <span class="pdp-specs-badge">{{ 'product.certified_specs' | t }}</span>
        </div>
        <div class="pdp-specs-grid">
          <div class="pdp-spec-item"><span class="pdp-spec-label">{{ 'product.height' | t }}</span><span class="pdp-spec-value">62 cm</span></div>
          <div class="pdp-spec-item"><span class="pdp-spec-label">{{ 'product.width' | t }}</span><span class="pdp-spec-value">50 cm</span></div>
          <div class="pdp-spec-item"><span class="pdp-spec-label">{{ 'product.depth' | t }}</span><span class="pdp-spec-value">30 cm</span></div>
          <div class="pdp-spec-item"><span class="pdp-spec-label">{{ 'product.total_volume' | t }}</span><span class="pdp-spec-value">70 L</span></div>
        </div>
      </div>
    </div>

    {%- comment -%} Details Column {%- endcomment -%}
    <div class="pdp-details-col">

      <div class="pdp-rating">
        <div class="pdp-rating-stars">
          {% render 'icon', name: 'star' %}{% render 'icon', name: 'star' %}{% render 'icon', name: 'star' %}{% render 'icon', name: 'star' %}{% render 'icon', name: 'star' %}
        </div>
        <span class="pdp-rating-score">4.9</span>
        <span class="pdp-rating-count">&middot; 128 {{ 'product.reviews' | t }}</span>
      </div>

      <h1 class="pdp-title">{{ product.title }}</h1>
      <p class="pdp-desc">{{ product.description | strip_html }}</p>

      <div class="pdp-price-box">
        <div class="pdp-price-row">
          <span class="pdp-price-main">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="pdp-price-compare">{{ current_variant.compare_at_price | money }}</span>
            {%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}
            {%- assign pct = savings | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="pdp-price-discount">{{ 'product.save_tag' | t }} {{ savings | money }} (-{{ pct }}%)</span>
          {% endif %}
        </div>
        <div class="pdp-installments">
          {% render 'icon', name: 'shield' %}
          {{ 'product.installments_prefix' | t }}
          <strong>{{ 'product.installments' | t }}</strong>
          {{ 'product.installments_suffix' | t }}
        </div>
      </div>

      {%- comment -%} Variant Selection {%- endcomment -%}
      {% if product.has_only_default_variant == false %}
        <div class="pdp-options">
          {% for option in product.options_with_values %}
            <div class="pdp-option-group">
              <div class="pdp-option-header">
                <span class="pdp-option-header-title">{{ forloop.index }}. {{ option.name }}</span>
              </div>
              <div class="pdp-option-radios">
                {% for value in option.values %}
                  {%- assign is_selected = false -%}
                  {% if option.selected_value == value %}{% assign is_selected = true %}{% endif %}
                  <div class="pdp-radio-card {% if is_selected %}active{% endif %}" data-variant-option data-option-index="{{ forloop.parentloop.index0 }}" data-value="{{ value }}">
                    <div class="pdp-radio-indicator"><div class="inner"></div></div>
                    <div class="pdp-radio-content">
                      <div class="pdp-radio-row">
                        <span class="pdp-radio-name">{{ value }}</span>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} What's Included {%- endcomment -%}
      <div class="pdp-whats-included">
        <h4 class="pdp-included-title">{{ 'product.package_title' | t }}</h4>
        <div class="pdp-included-grid">
          <div class="pdp-included-item">{% render 'icon', name: 'check' %} {{ 'product.package_item1' | t }}</div>
          <div class="pdp-included-item">{% render 'icon', name: 'check' %} {{ 'product.package_item2' | t }}</div>
          <div class="pdp-included-item">{% render 'icon', name: 'check' %} {{ 'product.package_item3' | t }}</div>
          <div class="pdp-included-item">{% render 'icon', name: 'check' %} {{ 'product.package_item4' | t }}</div>
        </div>
      </div>

      {%- comment -%} CTA Buttons {%- endcomment -%}
      <div class="pdp-cta-group">
        <form action="/cart/add" method="post" id="product-form">
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="variant-id-input">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="pdp-btn-add" data-add-to-cart data-variant-id="{{ current_variant.id }}">
            {% render 'icon', name: 'package' %}
            {{ 'general.add_to_cart' | t }}
          </button>
        </form>
        <a href="/checkout" class="pdp-btn-checkout">
          {{ 'general.proceed_checkout' | t }}
        </a>
      </div>

    </div>

  </div>
</div>

<script type="application/json" id="product-json">{{ product | json }}</script>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "settings": []
}
{% endschema %}
