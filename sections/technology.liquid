{%- comment -%} Technology Section — converted from Technology.jsx {%- endcomment -%}

<section class="tech-section" id="tecnologia">
  <div class="tech-container">

    <div class="tech-header">
      <div class="tech-pill">
        {% render 'icon', name: 'zap' %}
        <span>{{ 'technology.pill' | t }}</span>
      </div>
      <h2 class="tech-title">{{ section.settings.heading | default: 'technology.heading' | t }}</h2>
      <p class="tech-subtitle">{{ section.settings.subtitle | default: 'technology.subtitle' | t }}</p>
    </div>

    <div class="tech-grid">

      {%- comment -%} Left Column {%- endcomment -%}
      <div class="tech-cards-column">
        <div style="position:relative;">
          <div class="tech-card">
            <div class="tech-card-icon-wrapper">{% render 'icon', name: 'radar' %}</div>
            <h3 class="tech-card-title">{{ 'technology.card1_title' | t }}</h3>
            <p class="tech-card-desc">{{ 'technology.card1_desc' | t }}</p>
          </div>
          <svg class="tech-connector" style="position:absolute;width:4rem;height:4rem;color:rgba(6,182,212,0.6);left:100%;top:50%;margin-left:0.5rem;overflow:visible;" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4">
            <path d="M 0 10 C 32 10, 32 60, 64 60" style="animation:pulse-subtle 3s infinite"/>
            <circle cx="64" cy="60" r="3" fill="#06b6d4" stroke="none" style="animation:pulse-subtle 1.5s infinite"/>
          </svg>
        </div>

        <div style="position:relative;">
          <div class="tech-card">
            <div class="tech-card-icon-wrapper">{% render 'icon', name: 'layers' %}</div>
            <h3 class="tech-card-title">{{ 'technology.card2_title' | t }}</h3>
            <p class="tech-card-desc">{{ 'technology.card2_desc' | t }}</p>
          </div>
          <svg class="tech-connector" style="position:absolute;width:4rem;height:1rem;color:rgba(6,182,212,0.6);left:100%;top:50%;margin-left:0.5rem;margin-top:-0.5rem;overflow:visible;" viewBox="0 0 64 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4">
            <path d="M 0 8 L 64 8" style="animation:pulse-subtle 3s infinite"/>
            <circle cx="64" cy="8" r="3" fill="#06b6d4" stroke="none" style="animation:pulse-subtle 1.5s infinite"/>
          </svg>
        </div>

        <div style="position:relative;">
          <div class="tech-card">
            <div class="tech-card-icon-wrapper">{% render 'icon', name: 'sun' %}</div>
            <h3 class="tech-card-title">{{ 'technology.card3_title' | t }}</h3>
            <p class="tech-card-desc">{{ 'technology.card3_desc' | t }}</p>
          </div>
          <svg class="tech-connector" style="position:absolute;width:4rem;height:4rem;color:rgba(6,182,212,0.6);left:100%;bottom:50%;margin-left:0.5rem;overflow:visible;" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4">
            <path d="M 0 54 C 32 54, 32 4, 64 4" style="animation:pulse-subtle 3s infinite"/>
            <circle cx="64" cy="4" r="3" fill="#06b6d4" stroke="none" style="animation:pulse-subtle 1.5s infinite"/>
          </svg>
        </div>
      </div>

      {%- comment -%} Center Image {%- endcomment -%}
      <div class="tech-center">
        <div class="tech-glow"></div>
        <div class="tech-image-container" style="position:relative;z-index:10;">
          {% if section.settings.image %}
            <img src="{{ section.settings.image | image_url: width: 840 }}" alt="SmartClothes Technology" class="tech-image" loading="lazy">
          {% else %}
            <img src="{{ 'producto.jpeg' | asset_url }}" alt="SmartClothes Technology" class="tech-image" loading="lazy">
          {% endif %}
          <div class="tech-image-overlay">
            <div class="tech-image-status">
              <div class="tech-status-dot"></div>
              Dual-Zone Active
            </div>
            <div class="tech-image-version">Concept Prototype v2.4</div>
          </div>
        </div>
      </div>

      {%- comment -%} Right Column {%- endcomment -%}
      <div class="tech-cards-column" style="margin-top:2rem;">
        <div style="position:relative;">
          <div class="tech-card">
            <div class="tech-card-icon-wrapper">{% render 'icon', name: 'package' %}</div>
            <h3 class="tech-card-title">{{ 'technology.card4_title' | t }}</h3>
            <p class="tech-card-desc">{{ 'technology.card4_desc' | t }}</p>
          </div>
          <svg class="tech-connector" style="position:absolute;width:4rem;height:4rem;color:rgba(6,182,212,0.6);right:100%;top:50%;margin-right:0.5rem;overflow:visible;" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4">
            <path d="M 64 10 C 32 10, 32 60, 0 60" style="animation:pulse-subtle 3s infinite"/>
            <circle cx="0" cy="60" r="3" fill="#06b6d4" stroke="none" style="animation:pulse-subtle 1.5s infinite"/>
          </svg>
        </div>

        <div style="position:relative;">
          <div class="tech-card">
            <div class="tech-card-icon-wrapper">{% render 'icon', name: 'sliders-horizontal' %}</div>
            <h3 class="tech-card-title">{{ 'technology.card5_title' | t }}</h3>
            <p class="tech-card-desc">{{ 'technology.card5_desc' | t }}</p>
          </div>
          <svg class="tech-connector" style="position:absolute;width:4rem;height:1rem;color:rgba(6,182,212,0.6);right:100%;top:50%;margin-right:0.5rem;margin-top:-0.5rem;overflow:visible;" viewBox="0 0 64 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4">
            <path d="M 64 8 L 0 8" style="animation:pulse-subtle 3s infinite"/>
            <circle cx="0" cy="8" r="3" fill="#06b6d4" stroke="none" style="animation:pulse-subtle 1.5s infinite"/>
          </svg>
        </div>

        <div style="position:relative;">
          <div class="tech-card">
            <div class="tech-card-icon-wrapper">{% render 'icon', name: 'battery-charging' %}</div>
            <h3 class="tech-card-title">{{ 'technology.card6_title' | t }}</h3>
            <p class="tech-card-desc">{{ 'technology.card6_desc' | t }}</p>
          </div>
          <svg class="tech-connector" style="position:absolute;width:4rem;height:4rem;color:rgba(6,182,212,0.6);right:100%;bottom:50%;margin-right:0.5rem;overflow:visible;" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4">
            <path d="M 64 54 C 32 54, 32 4, 0 4" style="animation:pulse-subtle 3s infinite"/>
            <circle cx="0" cy="4" r="3" fill="#06b6d4" stroke="none" style="animation:pulse-subtle 1.5s infinite"/>
          </svg>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Technology",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading" },
    { "type": "textarea", "id": "subtitle", "label": "Section subtitle" },
    { "type": "image_picker", "id": "image", "label": "Center product image" }
  ]
}
{% endschema %}
