{%- comment -%} Product Purchase Section — converted from Shop.jsx
     Uses a real Shopify product selected via schema.
{%- endcomment -%}

{%- assign product = section.settings.product -%}

<section class="shop-section" id="comprar">
  <div class="shop-container">

    <div class="shop-header">
      <span class="shop-pill">{{ 'general.limited_edition' | t }}</span>
      <h2 class="shop-title">{{ section.settings.heading | default: 'Choose your SmartClothes' }}</h2>
      <p class="shop-subtitle">{{ section.settings.subtitle | default: 'Start transforming your home today with our special launch price.' }}</p>
    </div>

    {% if product %}
      {%- assign current_variant = product.selected_or_first_available_variant -%}

      <div class="shop-card">
        <div class="shop-grid">

          {%- comment -%} Image Column {%- endcomment -%}
          <div class="shop-image-column">
            <div class="shop-image-wrapper">
              <span class="shop-badge-launch">{{ 'general.launch' | t }}</span>
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title }}"
                class="shop-image"
                width="800"
                height="800"
                loading="lazy"
              >
            </div>
            <div class="shop-image-meta">
              <span class="shop-color-info">
                <span class="shop-color-label">{{ 'general.color' | t }}:</span>
                {{ current_variant.title }}
              </span>
              <span class="shop-stock-info">
                <span class="shop-stock-dot"></span>
                {% if current_variant.available %}
                  {{ 'general.in_stock' | t }} ({{ current_variant.inventory_quantity }} {{ 'general.units_left' | t }})
                {% else %}
                  Agotado
                {% endif %}
              </span>
            </div>
          </div>

          {%- comment -%} Details Column {%- endcomment -%}
          <div class="shop-details-column">
            <h3 class="shop-product-title">{{ product.title }}</h3>
            <p class="shop-product-desc">{{ product.description | strip_html | truncate: 120 }}</p>

            <div class="shop-price-container">
              <span class="shop-price-current">{{ current_variant.price | money }}</span>
              {% if current_variant.compare_at_price > current_variant.price %}
                <span class="shop-price-old">{{ current_variant.compare_at_price | money }}</span>
                {%- assign savings = current_variant.compare_at_price | minus: current_variant.price -%}
                <span class="shop-price-saving">{{ 'general.save' | t }} {{ savings | money }}</span>
              {% endif %}
            </div>

            <div class="shop-quantity-section">
              <span class="shop-quantity-label">{{ 'general.quantity' | t }}</span>
              <div class="shop-quantity-controls" data-quantity-selector>
                <button type="button" data-quantity-minus aria-label="Decrease quantity">
                  {% render 'icon', name: 'minus' %}
                </button>
                <span data-quantity-value>1</span>
                <button type="button" data-quantity-plus aria-label="Increase quantity">
                  {% render 'icon', name: 'plus' %}
                </button>
              </div>
            </div>

            <div class="shop-buttons">
              <button
                class="shop-add-btn"
                data-add-to-cart
                data-variant-id="{{ current_variant.id }}"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span class="shop-add-btn-icon">{% render 'icon', name: 'shopping-bag' %}</span>
                <span class="shop-add-btn-text">{{ 'general.add_to_cart' | t }}</span>
                <span class="shop-add-btn-price">· {{ current_variant.price | money }}</span>
              </button>

              <a href="{{ product.url }}" class="shop-details-link">
                {{ 'general.view_details' | t }}
              </a>
            </div>

            <div class="shop-benefits">
              <div class="shop-benefit-item">
                <span class="shop-benefit-icon">{% render 'icon', name: 'check' %}</span>
                {{ 'general.secure_shipping' | t }}
              </div>
              <div class="shop-benefit-item">
                <span class="shop-benefit-icon">{% render 'icon', name: 'check' %}</span>
                {{ 'general.warranty_included' | t }}
              </div>
              <div class="shop-benefit-item">
                <span class="shop-benefit-icon">{% render 'icon', name: 'check' %}</span>
                {{ 'general.purchase_protection' | t }}
              </div>
            </div>

            <div class="shop-shipping-alert">
              <span class="shop-shipping-icon">{% render 'icon', name: 'clock' %}</span>
              <p>{{ 'general.delivery_time' | t }} <strong>{{ 'general.business_days' | t }}</strong> {{ 'general.with_tracking' | t }}</p>
            </div>

          </div>
        </div>
      </div>
    {% else %}
      {%- comment -%} Fallback hardcoded if no product is selected in Theme Editor {%- endcomment -%}
      <div class="shop-card">
        <div class="shop-grid">
          <div class="shop-image-column">
            <div class="shop-image-wrapper">
              <span class="shop-badge-launch">{{ 'general.launch' | t }}</span>
              <img src="{{ 'producto.jpeg' | asset_url }}" alt="SmartClothes" class="shop-image" width="800" height="800" loading="lazy">
            </div>
            <div class="shop-image-meta">
              <span class="shop-color-info">
                <span class="shop-color-label">{{ 'general.color' | t }}:</span>
                Blanco Nórdico & Tapa Carbón
              </span>
              <span class="shop-stock-info">
                <span class="shop-stock-dot"></span>
                En stock (14 unidades restantes)
              </span>
            </div>
          </div>
          <div class="shop-details-column">
            <h3 class="shop-product-title">Cesto Inteligente SmartClothes</h3>
            <p class="shop-product-desc">Sistema autónomo dual para clasificación rápida y ordenada.</p>
            <div class="shop-price-container">
              <span class="shop-price-current">S/ 499.00</span>
              <span class="shop-price-old">S/ 599.00</span>
              <span class="shop-price-saving">Ahorras S/ 100.00</span>
            </div>
            <div class="shop-quantity-section">
              <span class="shop-quantity-label">{{ 'general.quantity' | t }}</span>
              <div class="shop-quantity-controls">
                <button type="button">{% render 'icon', name: 'minus' %}</button>
                <span>1</span>
                <button type="button">{% render 'icon', name: 'plus' %}</button>
              </div>
            </div>
            <div class="shop-buttons">
              <button class="shop-add-btn">
                <span class="shop-add-btn-icon">{% render 'icon', name: 'shopping-bag' %}</span>
                <span class="shop-add-btn-text">{{ 'general.add_to_cart' | t }}</span>
                <span class="shop-add-btn-price">· S/ 499.00</span>
              </button>
              <a href="#" class="shop-details-link">
                Ver descripción y detalles completos
              </a>
            </div>
            <div class="shop-benefits">
              <div class="shop-benefit-item"><span class="shop-benefit-icon">{% render 'icon', name: 'check' %}</span>{{ 'general.secure_shipping' | t }}</div>
              <div class="shop-benefit-item"><span class="shop-benefit-icon">{% render 'icon', name: 'check' %}</span>{{ 'general.warranty_included' | t }}</div>
              <div class="shop-benefit-item"><span class="shop-benefit-icon">{% render 'icon', name: 'check' %}</span>{{ 'general.purchase_protection' | t }}</div>
            </div>
            <div class="shop-shipping-alert">
              <span class="shop-shipping-icon">{% render 'icon', name: 'clock' %}</span>
              <p>{{ 'general.delivery_time' | t }} <strong>{{ 'general.business_days' | t }}</strong> {{ 'general.with_tracking' | t }}</p>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Product Purchase",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Choose your SmartClothes" },
    { "type": "textarea", "id": "subtitle", "label": "Section subtitle" }
  ]
}
{% endschema %}
